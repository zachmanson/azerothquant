# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local Lua toolchain built by hererocks (see README)
.lua/

# Per-machine Brain config (copy from brain/config.example.toml)
brain/config.toml

# The Brain's history database (default location)
brain/history.sqlite

# The Brain's log and single-instance lock (next to the config, #115)
brain/brain.log*
brain/brain.lock

# PyInstaller output (brain/AzerothQuantBrain.spec)
brain/build/
brain/dist/

# The Scan Archive (default location)
brain/archive/

# The player's Predictions (copy from brain/predictions.example.toml)
brain/predictions.toml

# Frozen Grades and held-at-writing costs (the Brain writes them, #66)
brain/grades.toml

# Per-machine Claude Code settings
.claude/settings.local.json

# Scan Pool Worker (pool/)
pool/node_modules/
pool/.wrangler/
pool/.dev.vars
pool/.cloudflare-token
